{
  "expo": {
    "name": "Mobile ThreatGuard",
    "slug": "mobile-threatguard",
    "scheme": "threatguard",
    "version": "0.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "primaryColor": "#4F8CFF",
    "ios": {
      "bundleIdentifier": "com.threatguard.mobile",
      "supportsTablet": false
    },
    "android": {
      "package": "com.threatguard.mobile",
      "versionCode": 1,
      "allowBackup": false,
      "softwareKeyboardLayoutMode": "pan",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      "./plugins/withThreatGuardNative"
    ]
  }
}
