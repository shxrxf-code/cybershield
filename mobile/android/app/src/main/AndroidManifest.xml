<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      App inspection needs to enumerate installed packages. On Android 11+ this requires
      a <queries> declaration to see apps beyond the ones that match implicit intents.
      We declare intent filters for common app categories so the inspection can see
      most user-installed applications without needing QUERY_ALL_PACKAGES.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="text/plain" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
        </intent>
    </queries>

    <!--
      File scanning goes through the Storage Access Framework: the user picks
      exactly which documents to share, so no runtime storage permission is
      required. INTERNET is only used for the optional hash reputation lookup.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Only used to raise our own local alert notification when a flagged message
      is detected. Requested at runtime (Android 13+); ignored on older versions.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="false"
      android:theme="@style/AppTheme"
      android:usesCleartextTraffic="${usesCleartextTraffic}"
      android:supportsRtl="true">
      <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:theme="@style/Theme.App.SplashScreen"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|assetsPaths"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
        <!-- Deep link scheme used by expo-dev-client: lets `expo start
             --dev-client` open this build via threatguard:// and lets the dev
             launcher hand the project URL back to the app. -->
        <intent-filter>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="threatguard" />
        </intent-filter>
      </activity>

      <!--
        Notification monitoring. Android only binds this service once the user
        grants notification access in system settings; the BIND_ permission means
        only the system can bind it, so it stays private. It reads the text the
        OS exposes and performs no other access.

        This is a NotificationListenerService: the intent-filter below is what
        the system settings screen matches when the user enables notification
        access for ThreatGuard.
      -->
      <service
        android:name=".notification.NotificationMonitorService"
        android:label="@string/app_name"
        android:exported="false"
        android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
        <intent-filter>
          <action android:name="android.service.notification.NotificationListenerService" />
        </intent-filter>
      </service>
    </application>
</manifest>
