# ---------------------------------------------------------------------------
# CyberShield repository root ignores
# ---------------------------------------------------------------------------

# Python bytecode / caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Virtual environments
.venv/
venv/
env/

# Environment / secrets — never commit real credentials
.env
.env.*
!.env.example
*.pem
*.key

# Local databases and runtime state
*.db
*.sqlite
*.sqlite3
*.log
var/
logs/

# Build artefacts
build/
dist/
*.egg-info/
.eggs/

# OS / editor noise
.DS_Store
Thumbs.db
*.swp
*~

# Flutter/Dart workspace-local files (see client/.gitignore for full set)
client/.dart_tool/
client/build/
client/.flutter-plugins
client/.flutter-plugins-dependencies
