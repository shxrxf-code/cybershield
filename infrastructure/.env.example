# CyberShield stack secrets & overrides — copy to infrastructure/.env
#
# Docker Compose automatically loads `.env` from the directory that contains
# the compose file (this one), so fill these in here rather than the shell.
#
# Generate fresh values with:
#
#     scripts/generate-secrets.sh
#
# The compose file refuses to start (and the API refuses to boot in production)
# without POSTGRES_PASSWORD, SECRET_KEY and QUARANTINE_ENCRYPTION_KEY.

# PostgreSQL password for the `cybershield` role. Alphanumeric is fine; if you
# choose a custom password that contains URL-reserved characters (@ : /), the
# API must receive it percent-encoded inside DATABASE_URL.
POSTGRES_PASSWORD=

# JWT signing/verification secret. Pinned per environment — never let the app
# generate one per process (it would invalidate every token on restart).
SECRET_KEY=

# 64 hex chars = 32 bytes of key material. The app SHA-256-wraps it into the
# AES-256-GCM key used for quarantine blobs at rest. NEVER change it after real
# quarantine data exists.
QUARANTINE_ENCRYPTION_KEY=

# --- Optional overrides (sent straight to the api container) ---------------

# Deployment personality. "production" enforces SECRET_KEY and DEBUG=false.
# ENVIRONMENT=production

# Comma-separated CORS origins the API should allow.
# CORS_ORIGINS=https://scan.example.com

# Serve /docs and /redoc (defaults to true).
# DOCS_ENABLED=true