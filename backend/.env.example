# =============================================================================
# Mobile ThreatGuard – backend environment
# Copy to `.env` and fill in.  NEVER commit a real `.env` or real keys.
# =============================================================================

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=debug

# Trust setting for Express when running behind a reverse proxy.
# Leave empty when exposing the server directly (rate limiting then keys on
# the direct peer address, which cannot be spoofed). Values: true | loopback |
# uniquel | <subnet/cidr>. See https://expressjs.com/en/guide/behind-proxies.html
# TRUST_PROXY=loopback

# --- Database ----------------------------------------------------------------
# Dev default: a local SQLite file (uses Node's built-in node:sqlite).
# Production: a standard PostgreSQL connection string.
# DB_CLIENT is inferred from the URL scheme when omitted.
# DB_CLIENT=sqlite
DATABASE_URL=file:./data/threatguard.sqlite

# Example PostgreSQL (production):
# DB_CLIENT=postgres
# DATABASE_URL=postgres://threatguard:change-me@localhost:5432/threatguard

# --- API authentication ------------------------------------------------------
# Comma-separated SHA-256 hashes (hex) of the API keys the mobile app may use.
# Generate a key + its hash with:  npm run --silent gen:key  (see docs/api)
# The plaintext key is stored ONLY on the device; the server stores hashes.
API_KEY_HASHES=

# --- Rate limiting -----------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# --- Threat-intelligence providers -------------------------------------------
# All keys live server-side. The mobile application ships none of them.
# Google Safe Browsing v4
GOOGLE_SAFE_BROWSING_API_KEY=
# abuse.ch URLhaus (an Auth-Key is required by abuse.ch for the API)
URLHAUS_AUTH_KEY=
# VirusTotal v3
VIRUSTOTAL_API_KEY=

# Global kill-switches, useful for offline development and tests.
INTEL_ENABLED=true
INTEL_TIMEOUT_MS=6000
INTEL_CACHE_TTL_SECONDS=21600
# Minimum milliseconds between outbound calls to the same provider.
INTEL_MIN_REQUEST_INTERVAL_MS=0

# --- CORS --------------------------------------------------------------------
# Comma-separated origins allowed to call the API. Empty = same-origin only.
CORS_ALLOWED_ORIGINS=
