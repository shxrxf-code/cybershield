# CyberShield backend environment template.
#
# Copy to `.env` and fill in real values. Never commit a `.env` file.
# Every runtime secret (database, JWT, quarantine encryption, third-party
# threat-intelligence keys) is configuration-only; nothing is hard-coded.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
# development | test | staging | production
ENVIRONMENT=development
DEBUG=false
# None = serve /docs and /redoc; set "false" to disable.
DOCS_ENABLED=true
# No default value. Generate one per environment:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# ---------------------------------------------------------------------------
# Database (PostgreSQL in production; SQLite only for local development/tests)
# ---------------------------------------------------------------------------
# Produce with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=
DATABASE_URL=sqlite+aiosqlite:///./cybershield.db
# Example production value (docker-compose provides the host):
# DATABASE_URL=postgresql+asyncpg://cybershield:${POSTGRES_PASSWORD}@db:5432/cybershield
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ---------------------------------------------------------------------------
# Redis (rate limiting + queue signalling)
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
# Set true only when the scan worker runs as a separate process and the queue
# publishes through Redis; otherwise the in-process worker is used.
USE_REDIS_QUEUE=false

# ---------------------------------------------------------------------------
# HTTP
# ---------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_ALLOW_CREDENTIALS=false
# Trust X-Forwarded-For only when the deployment sits behind a proxy that
# overwrites it. Never enable on a directly-exposed host.
TRUST_PROXY_HEADERS=false

# ---------------------------------------------------------------------------
# Rate limiting (requests per minute)
# ---------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_PER_MINUTE=60
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_SCAN_PER_MINUTE=30
RATE_LIMIT_FILE_SCAN_PER_MINUTE=10

# ---------------------------------------------------------------------------
# Uploads / quarantine storage
# ---------------------------------------------------------------------------
# Where uploaded blobs, quarantined copies and temp files live.
STORAGE_ROOT=./data
MAX_UPLOAD_BYTES=104857600         # 100 MiB
MAX_EMAIL_BYTES=26214400           # 25 MiB
KEEP_FILES_AFTER_SCAN=false        # true keeps worker temp blobs (forensics)
QUARANTINE_ENABLED=true
QUARANTINE_RETENTION_DAYS=14
# Optional at-rest encryption for quarantined blobs. If set, the cryptography
# package *must* be installed and the key must never change. Produce with:
#   python -c "import secrets; print(secrets.token_hex(16))"   # 32 hex chars
QUARANTINE_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Scans
# ---------------------------------------------------------------------------
SCAN_RETENTION_DAYS=90
URL_FETCH_MAX_BYTES=2097152          # 2 MiB response cap
URL_MAX_REDIRECTS=10
OCR_MAX_CHARACTERS=20000
CLAMAV_MAX_SCAN_BYTES=104857600      # 100 MiB ceiling

# ---------------------------------------------------------------------------
# Security / passwords
# ---------------------------------------------------------------------------
ARGON2_ENABLED=true
PASSWORD_MIN_LENGTH=12
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# ---------------------------------------------------------------------------
# Third-party threat intelligence (optional; must be present to enable a provider)
# API keys are environment-only. A provider that is configured here is used for
# scans only when the user consents to third-party lookups on each request.
# ---------------------------------------------------------------------------
# VIRUSTOTAL_API_KEY=
# URLHAUS_URL=https://urlhaus-api.abuse.ch/v1/
# OTX_API_KEY=
# IPQUALITYSCORE_API_KEY=

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
# Path to the YARA rules directory (optional; defaults to ./detection-engine/yara/rules).
YARA_RULES_DIR=./detection-engine/yara/rules